{
	"layer": "top",
	"position": "top",
	"modules-left": [
		"custom/launcher",
		"custom/polycat",
		"hyprland/workspaces"
	],
	"modules-center": [
		"hyprland/window",
		"custom/music"
	],
	"modules-right": [
	    "group/status",
		"tray",
		"custom/power"
	],
	"group/status": {
		"orientation": "horizontal",
	    "modules": [
			"pulseaudio",
			"custom/ddcutil",
			"clock"
		]
	},
	"hyprland/workspaces": {
		"on-click": "activate",
		"on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
		"on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
		"format": "{icon}",
		"all-outputs": true,
		"format-icons": {
			"1": "",
			"2": "󰖟",
			"3": "",
			"4": "󰎉",
			"5": "󰛳",
			"default": ""
		}
	},
	"tray": {
		"icon-size": 21,
		"spacing": 10
	},
	"custom/music": {
		"format": "  {}",
		"escape": true,
		"interval": 5,
		"tooltip": false,
		"exec": "playerctl metadata --format='{{ title }}'",
		"on-click": "playerctl play-pause",
		"max-length": 50
	},
	"clock": {
		"timezone": "Asia/Hong Kong",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"format-alt": " {:%d/%m/%Y}",
		"format": " {:%H:%M}"
	},
	"custom/ddcutil": {
		"format": "{percentage}% {icon}",
		"interval": 1,
		"on-scroll-up": "ddcutil setvcp --bus 10 10 $(expr `ddcutil getvcp --bus 10 10 | grep -oP '[0-9]+' | tail -2 | head -1` + 10)",
		"on-scroll-down": "ddcutil setvcp --bus 10 10 $(expr `ddcutil getvcp --bus 10 10 | grep -oP '[0-9]+' | tail -2 | head -1` - 10)",
		"on-click": "ddcutil setvcp 10 50",
		"exec": "~/.config/waybar/waybar-ddcutil.py",
		"format-icons": [
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			""
		],
		"return-type": "json"
	},
	"battery": {
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "{icon}",
		"format-charging": "󰂄",
		"format-plugged": "",
		"format-alt": "{icon}",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		]
	},
	"pulseaudio": {
		// "scroll-step": 1, // %, can be a float
		"format": "{icon} {volume}%",
		"format-muted": "",
		"format-icons": {
			"default": [
				"",
				"",
				" "
			]
		},
		"on-click": "pavucontrol"
	},
	"custom/lock": {
		"tooltip": false,
		"on-click": "hyprlock &",
		"format": ""
	},
	"custom/power": {
		"tooltip": false,
		"on-click": "wlogout &",
		"format": "⏻"
	},
	"hyprland/language": {
		"format": " {}",
		"format-en": "en",
		"format-fa": "fa",
		"interval": 1,
		"keyboard-name": "gaming-keyboard",
		"on-click": "hyprctl switchxkblayout gaming-keyboard next"
	},
	"custom/launcher":{
		"format": "",
		"on-click": "fuzzel --config ~/.config/fuzzel/menu.ini",
		"on-click-right": "fuzzel --config ~/.config/fuzzel/menu.ini"
	},
	"custom/polycat":{
		"exec": "polycat",
		"return-type": "json",
		"format": "{text}",
		"tooltip": false,
		"restart-interval": 5
	}
}
